# Environment variables for local development.
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# --- vitals-api ---
API_USERNAME=vitals-user
API_PASSWORD=change-me-before-running

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/vitals

# --- Service ports ---
VITALS_API_PORT=8080
VITALS_CONSUMER_PORT=8081
